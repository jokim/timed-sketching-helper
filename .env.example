# Register a DeviantArt application at https://www.deviantart.com/developers/
# then copy its client id and secret here.
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=

# Redirect URI for the "Connect DeviantArt" login. Add this exact value to your
# DeviantArt app's OAuth2 Redirect URI Whitelist. Logging in (with an account
# that has mature content enabled) is what stops sensitive images from being
# served blurred.
DEVIANTART_REDIRECT_URI=http://127.0.0.1:8765/auth/deviantart/callback

# Include mature-content deviations when fetching lists (true/false).
DA_MATURE_CONTENT=true

# Where the SQLite database and image cache live.
DATA_DIR=./data

# How long a fetched list stays "fresh" before the UI offers a refresh.
LIST_TTL_HOURS=24

# Stop fetching a list once it reaches this many images (a session only shows a
# handful). Capped at 1000 whatever you set here.
MAX_IMAGES=1000

# Stop a single list fetch after this many upstream DeviantArt API requests.
# This is a default, not a hard limit — the "Max API requests" advanced option
# raises it per fetch (up to 1000). A big album that is mostly sensitive images
# (all filtered out) can otherwise page endlessly and hit DeviantArt's rate
# limit. Default 100.
MAX_REQUESTS=100
