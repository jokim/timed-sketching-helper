# Copy this file to ".env" and fill in / adjust the values you need. Every
# variable below is already set to its built-in default (see config.py), so
# you can delete any line you don't want to override and the app will fall
# back to that default. The two DeviantArt credential lines are the only
# ones without a usable default — the app can't reach the DeviantArt API
# without them.

# Register a DeviantArt application at https://www.deviantart.com/developers/
# then copy its client id and secret here.
DEVIANTART_CLIENT_ID=
DEVIANTART_CLIENT_SECRET=

# Redirect URI for the "Connect DeviantArt" login. Add this exact value to your
# DeviantArt app's OAuth2 Redirect URI Whitelist. Logging in (with an account
# that has mature content enabled) is what stops sensitive images from being
# served blurred.
DEVIANTART_REDIRECT_URI=http://127.0.0.1:8765/auth/deviantart/callback

# Include mature-content deviations when fetching lists (true/false).
DA_MATURE_CONTENT=true

# Where the SQLite database and image cache live.
DATA_DIR=./data

# How long a fetched list stays "fresh" before the UI offers a refresh.
LIST_TTL_HOURS=24

# How long downloaded image bytes stay cached on disk before being
# re-downloaded on next use. Artwork itself rarely changes, so this is much
# longer than LIST_TTL_HOURS. Default 720 (30 days).
IMAGE_TTL_HOURS=720

# The most images a single list fetch may ever pull, whatever the "Limit
# images fetched" advanced option in the UI asks for. Default 300; no hard
# ceiling, but raise with care — every page of results costs one upstream API
# request against DeviantArt's rate limit (see MAX_REQUESTS below), so a very
# large value can exhaust that quota on a single fetch. Aim to keep this in
# the low thousands at most. (A fetch that doesn't specify a "Limit images
# fetched" amount pulls 200 by default, not this ceiling — see
# DEFAULT_FETCH_IMAGES in config.py, which isn't itself env-configurable.)
MAX_IMAGES=300

# Stop a single list fetch after this many upstream DeviantArt API requests.
# This is a default, not a hard limit — the "Max API requests" advanced option
# raises it per fetch (up to 1000). A big album that is mostly sensitive images
# (all filtered out) can otherwise page endlessly and hit DeviantArt's rate
# limit. Default 100.
MAX_REQUESTS=100
